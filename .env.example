# --- Database (PostgreSQL) ---
# Local dev uses the Docker Postgres in docker-compose.yml (port 5433).
# For production use a Neon project: copy the POOLED url into DATABASE_URL
# and the DIRECT (non-pooled) url into DIRECT_URL.
DATABASE_URL="postgresql://carshia:carshia@localhost:5433/carshia?schema=public"
DIRECT_URL="postgresql://carshia:carshia@localhost:5433/carshia?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Public base URL of the app (http://localhost:3000 locally, your Vercel URL in prod)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Stripe (card payments) ---
# Test keys are fine for local dev; use live keys in prod.
# Get them from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Local webhook secret comes from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
# In production, copy the signing secret from the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."
